rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function userDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role(){ return signedIn() ? userDoc().data.role : null; }
    function isAdmin(){ return role() in ['PLATFORM_ADMIN', 'ncpor_admin']; }
    function isReviewer(){ return role() == 'SCIENTIFIC_REVIEWER' || isAdmin(); }
    function isMedia(){ return role() in ['MEDIA_MANAGER', 'media_content'] || isReviewer(); }
    function isResearcher(){ return role() in ['RESEARCHER', 'researcher_scientist'] || isReviewer(); }
    function publicPublished(){ return resource.data.accessLevel == 'PUBLIC' && resource.data.approvalStatus in ['APPROVED','PUBLISHED']; }
    function owner(){ return signedIn() && resource.data.createdBy == request.auth.uid; }
    function creatingOwn(){ return signedIn() && request.resource.data.createdBy == request.auth.uid; }
    function notificationOwner(){ return signedIn() && (resource.data.get('uid', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid); }
    function safeRoleChange(){ return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','uid','email']); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role in ['PUBLIC_USER', 'public_student', 'researcher_scientist', 'media_content'];
      allow update: if signedIn() && ((request.auth.uid == uid && safeRoleChange()) || isAdmin());
      allow delete: if isAdmin();
      match /learning_progress/{progressId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /{collection}/{id} {
      allow read: if collection in ['expeditions','datasets','publications','researchReports','documents','media','researchProjects','stations','researchers','institutions','news','events','educationContent']
                  && (publicPublished() || signedIn());
      allow create: if collection in ['expeditions','datasets','publications','researchReports','documents','media','researchProjects']
                    && isResearcher() && creatingOwn() && request.resource.data.approvalStatus == 'DRAFT';
      allow update: if collection in ['expeditions','datasets','publications','researchReports','documents','media','researchProjects']
                    && ((owner() && resource.data.approvalStatus in ['DRAFT','REVISION_REQUESTED']) || isReviewer());
      allow delete: if isAdmin() || (owner() && resource.data.approvalStatus == 'DRAFT');
    }

    match /reviews/{id} {
      allow read: if isReviewer() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create, update: if isReviewer();
      allow delete: if isAdmin();
    }
    match /approvalRequests/{id} {
      allow create: if isResearcher() && creatingOwn();
      allow read: if signedIn() && (resource.data.createdBy == request.auth.uid || isReviewer());
      allow update: if isReviewer();
      allow delete: if isAdmin();
    }
    match /aiGeneratedContent/{id} {
      allow read: if isMedia() || resource.data.get('status', '') in ['PUBLISHED', 'APPROVED'];
      allow create: if isMedia();
      allow update: if isMedia();
      allow delete: if isAdmin();
    }
    match /workspaces/{id} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUids;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /collections/{id} {
      allow read, write: if signedIn() && (resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == request.auth.uid);
    }
    match /notifications/{id} {
      allow read: if notificationOwner();
      allow update: if notificationOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create: if isAdmin();
    }
    match /savedSearches/{id} { allow read, write: if signedIn() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid); }
    match /subscriptions/{id} { allow read, write: if signedIn() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid); }
    match /knowledgeGraphNodes/{id} { allow read: if true; allow write: if isReviewer(); }
    match /knowledgeGraphEdges/{id} { allow read: if true; allow write: if isReviewer(); }
    match /datasetVersions/{id} { allow read: if true; allow create: if isResearcher(); allow update, delete: if isReviewer(); }
    match /instruments/{id} { allow read: if true; allow write: if isResearcher(); }
    match /samples/{id} { allow read: if signedIn(); allow create, update: if isResearcher(); allow delete: if isAdmin(); }
    match /observations/{id} { allow read: if signedIn(); allow create, update: if isResearcher(); allow delete: if isAdmin(); }
    match /campaigns/{id} { allow read: if isMedia() || isResearcher() || resource.data.get('status', '') in ['PUBLISHED', 'APPROVED']; allow write: if isMedia(); }
    match /quizzes/{id} { allow read: if true; allow write: if isReviewer(); }
    match /quizResults/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    match /analytics/{id} { allow read: if isReviewer(); allow write: if isAdmin(); }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /apiKeys/{id} { allow read, write: if signedIn() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid); }
    match /systemSettings/{id} { allow read, write: if isAdmin(); }
  }
}
